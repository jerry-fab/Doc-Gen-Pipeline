#!/bin/sh
# ==============================================================================
# Git Pre-Commit Hook for Automated Architecture Documentation
# ==============================================================================
# This hook runs locally on the developer machine during `git commit`.
# It inspects staged code files (.cs, .py, .java), generates updated
# class architecture documentation into `docs/`, and stages the docs
# so they are bundled into the EXACT same commit.
#
# Server Impact: ZERO. Works on any Git server (Gogs, GitLab, Bitbucket, GitHub).
# ==============================================================================

# Locate Python executable
if command -v python3 >/dev/null 2>&1; then
    PYTHON_CMD="python3"
elif command -v python >/dev/null 2>&1; then
    PYTHON_CMD="python"
elif command -v py >/dev/null 2>&1; then
    PYTHON_CMD="py"
else
    echo "[Doc-Gen Hook] Warning: Python not found in PATH. Skipping doc generation."
    exit 0
fi

# Locate the Doc-Gen-Pipeline path
# 1. Check if DOC_GEN_PIPELINE_DIR environment variable is set
# 2. Check if sibling folder "Github-Pipeline" exists
# 3. Check hardcoded fallback path
PIPELINE_DIR="${DOC_GEN_PIPELINE_DIR}"

if [ -z "$PIPELINE_DIR" ] || [ ! -f "$PIPELINE_DIR/analyzer/main.py" ]; then
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    # Try sibling directory
    if [ -f "$SCRIPT_DIR/../../Github-Pipeline/analyzer/main.py" ]; then
        PIPELINE_DIR="$(cd "$SCRIPT_DIR/../../Github-Pipeline" && pwd)"
    elif [ -f "D:/Project-Folders/LDL/LDL-POC/Github-Pipeline/analyzer/main.py" ]; then
        PIPELINE_DIR="D:/Project-Folders/LDL/LDL-POC/Github-Pipeline"
    fi
fi

if [ -z "$PIPELINE_DIR" ] || [ ! -f "$PIPELINE_DIR/analyzer/main.py" ]; then
    echo "[Doc-Gen Hook] Notice: Doc-Gen-Pipeline not detected. Skipping auto-docs."
    exit 0
fi

MAIN_PY="$PIPELINE_DIR/analyzer/main.py"

# Quick check: are any supported source files (.cs, .py, .java) staged?
STAGED_FILES=$(git diff --cached --name-only | grep -E '\.(cs|py|java)$')

if [ -z "$STAGED_FILES" ]; then
    # No relevant code files staged; proceed with commit immediately
    exit 0
fi

echo ""
echo "============================================================"
echo "[Doc-Gen Hook] Detected staged code changes:"
echo "$STAGED_FILES"
echo "[Doc-Gen Hook] Generating class architecture documentation..."
echo "============================================================"

# Run the analyzer in staged mode
"$PYTHON_CMD" "$MAIN_PY" --staged --output-dir docs

STATUS=$?
if [ $STATUS -ne 0 ]; then
    echo "[Doc-Gen Hook] Warning: Documentation generator exited with code $STATUS."
    # We do not block the commit if doc generation has an issue
fi

# If documentation files were created or modified in docs/, stage them now
if [ -d "docs" ]; then
    git add docs/
    echo "[Doc-Gen Hook] Class documentation staged into current commit."
fi

echo "============================================================"
echo ""
exit 0
