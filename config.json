{
  "active_profile": "local",
  "profiles": {
    "local": {
      "provider": "gemini",
      "description": "100% Free tier cloud API (Gemini 1.5/2.0 Flash or Groq)",
      "enabled": false,
      "api_key": "",
      "api_base": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "model": "gemini-1.5-flash",
      "temperature": 0.1,
      "timeout_seconds": 30
    },
    "production": {
      "provider": "mistral",
      "description": "Enterprise precision model (Codestral or Claude via OpenRouter)",
      "enabled": false,
      "api_key": "",
      "api_base": "https://api.mistral.ai/v1",
      "model": "codestral-latest",
      "temperature": 0.1,
      "timeout_seconds": 45
    }
  },
  "generator": {
    "output_dir": "docs",
    "include_mermaid_diagrams": true,
    "max_fields_in_diagram": 5
  },
  "scanner": {
    "supported_extensions": [".py", ".cs", ".java"],
    "ignored_directories": [
      ".git",
      ".github",
      "docs",
      "venv",
      ".venv",
      "bin",
      "obj",
      "node_modules",
      "__pycache__",
      "build",
      "dist"
    ]
  }
}
